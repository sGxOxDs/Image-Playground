{
  "name": "react-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node ./scripts/build-pwa.mjs",
    "build:static": "node ./scripts/build-static.mjs",
    "dev": "react-router dev",
    "devlop": "node ./scripts/publish-pages.mjs dev",
    "publish:pages": "node ./scripts/publish-pages.mjs stable",
    "start": "node --import ./scripts/local-bind.mjs ./node_modules/@react-router/serve/bin.cjs ./build/server/index.js",
    "start:api": "node --import ./scripts/local-bind.mjs ./node_modules/@react-router/serve/bin.cjs ./build-static/server/index.js",
    "start:static": "node ./scripts/serve-static.mjs",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "http-server": "14.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
